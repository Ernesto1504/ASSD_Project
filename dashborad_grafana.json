          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "ag0pmrwmhd14wf"
                      },
                      "spec": {
                        "editorMode": "builder",
                        "expr": "ILO_CPU_Util{machine=\"DL380A\"}",
                        "legendFormat": "Utilizzo CPU",
                        "range": true
