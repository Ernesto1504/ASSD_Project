      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Energia Consumata (Cumulativa) - DL380A",
          "description": "Energia elettrica totale consumata dal server (in Wattora - Wh) nell'intervallo selezionato, ottenuta integrando nel tempo i campionamenti di potenza a intervalli di 15 secondi: E = sum(P * 15) / 3600. Costituisce il parametro fondamentale E (Energy) per il calcolo delle emissioni operative O = (E * I) secondo lo standard Software Carbon Intensity (SCI) della Green Software Foundation.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "ag0pmrwmhd14wf"
                      },
                      "spec": {
                        "editorMode": "builder",
                        "expr": "sum(sum_over_time(ILO_PowerSupply{machine=\"DL380A\"}[$__range]) * 15) / 3600",
                        "interval": "15s",
                        "legendFormat": "__auto",
                        "range": true
                      }
                    },
                    "refId": "Alimentazione - DL380A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
