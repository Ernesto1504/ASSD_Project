      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Potenza CPU (DL380A) vs Resto del Server",
          "description": "Ripartizione (stacked) dell'assorbimento elettrico tra il comparto di calcolo (CPU) e il baseload del resto dell'hardware (RAM, scheda madre, dischi, ventole). Evidenzia l'overhead fisso della macchina (~247 W costanti) rispetto alla frazione dinamica imputabile direttamente all'esecuzione dell'algoritmo sui processori.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "ag0pmrwmhd14wf"
                      },
                      "spec": {
                        "editorMode": "builder",
                        "expr": "sum(ILO_CPU_Power{machine=\"DL380A\"})",
                        "legendFormat": "Potenza CPU - DL380A",
                        "range": true
                      }
                    },
                    "refId": "Potenza CPU - DL380A",
                    "hidden": false
                  }
                },
                {
